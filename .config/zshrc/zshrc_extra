# Merge/pull request review helpers (gh = GitHub, glab = GitLab)
alias mrs="glab mr list"
alias mrv="glab mr view"          # mrv <id>       — description + discussion
alias mrd="glab mr diff"          # mrd <id>       — full diff
alias mrco="glab mr checkout"     # mrco <id>      — check out the MR branch
alias mra="glab mr approve"
