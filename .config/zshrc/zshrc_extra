# ---- Zoxide (better cd) ----
eval "$(zoxide init zsh)"
alias cd="z"

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

# ---- Eza (better ls) -----
alias ls="eza --icons=always"

export EDITOR=nvim

# thefuck alias (lazy)
# `thefuck --alias` takes ~67ms and was previously run twice on every shell
# start. These stubs cost nothing and swap themselves out for the real
# functions the first time you actually invoke one.
_load_thefuck() {
	unfunction fuck fk _load_thefuck 2>/dev/null
	eval "$(thefuck --alias)"
	eval "$(thefuck --alias fk)"
}
fuck() { _load_thefuck; fuck "$@"; }
fk() { _load_thefuck; fk "$@"; }

# Initialize fzf - handle various versions
if command -v fzf &>/dev/null; then
  if fzf --zsh &>/dev/null 2>&1; then
    eval "$(fzf --zsh)"
  elif fzf --bash &>/dev/null 2>&1; then
    eval "$(fzf --bash)"
  else
    [ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
  fi
fi

# -- Use fd instead of fzf --

export FZF_DEFAULT_COMMAND="fd --hidden --strip-cwd-prefix --exclude .git"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type=d --hidden --strip-cwd-prefix --exclude .git"

# Use fd (https://github.com/sharkdp/fd) for listing path candidates.
# - The first argument to the function ($1) is the base path to start traversal
# - See the source code (completion.{bash,zsh}) for the details.
_fzf_compgen_path() {
  fd --hidden --exclude .git . "$1"
}

# Use fd to generate the list for directory completion
_fzf_compgen_dir() {
  fd --type=d --hidden --exclude .git . "$1"
}

