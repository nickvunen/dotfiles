{
  "$schema": "https://opencode.ai/config.json",
  "model": "amazon-bedrock/eu.anthropic.claude-opus-5",
  "small_model": "amazon-bedrock/eu.anthropic.claude-sonnet-5-5",
  "plugin": [
    "oh-my-opencode-slim"
  ],
  "provider": {
    "amazon-bedrock": {
      "options": {
        "profile": "{file:~/.config/opencode/.bedrock-profile}",
        "region": "eu-west-1",
        "cross_region": false
      }
    },
    "ollama": {
      "models": {
        "gemma4": {
          "_launch": true,
          "name": "gemma4"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "mcp": {
    "basic-memory": {
      "type": "local",
      "command": [
        "basic-memory",
        "mcp"
      ],
      "enabled": true
    },
    "caveman": {
      "type": "local",
      "command": [
        "node",
        "/Users/nickvanunen/dotfiles/mcp/caveman/dist/index.js"
      ],
      "enabled": true
    },
    "ecmwf": {
      "type": "remote",
      "url": "https://mcp.ecmwf.int",
      "enabled": true
    }
  },
  "lsp": true,
  "experimental": {
    "todo": true
  }
}
