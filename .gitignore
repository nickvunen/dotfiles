
# Not needed dirs from .config
gh/
gh-copilot/
github-copilot/
.config/github-copilot/**
.config/github-copilot/
.config/github-copilot
htop/
btop/
iterm2/
yarn/

# opencode: track config, exclude secrets / state / generated
.config/opencode/opencode.json.bak
.config/opencode/weave-opencode.json
.config/opencode/node_modules/
.config/opencode/bun.lock
.config/opencode/.bedrock-profile

# Weave runtime state
.weave/

# uv cache receipts
.config/uv/

# App state / credentials written into .config
.config/acli/
.config/blender-mcp/
.config/configstore/
.config/opencode-mobile/

# Personal configurations
.config/nvim/lua/user/plugins/dap-config.lua
.config/gh/

# Python cache
__pycache__/

# Sensitive files
.gitconfig
*_history
*.log

# AI
# Note: the repo's own AGENTS.md is tracked, so this only ignores stray
# AGENTS.md/CLAUDE.md files that tooling drops into subdirectories.
AGENTS.md
CLAUDE.md
!/AGENTS.md
!.config/opencode/AGENTS.md
!.config/claude/CLAUDE.md
!.config/codex/AGENTS.md

# macOS
.DS_Store

# Editor/tool backups
*.bak
*.bak.*
